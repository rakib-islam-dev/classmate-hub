rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School platform rules:
    // Allow authenticated or open read/write for classroom students and classmates
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /direct_messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    match /channel_messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    match /channels/{channelId} {
      allow read: if true;
      allow write: if true;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /reels/{reelId} {
      allow read: if true;
      allow write: if true;
    }

    match /help_tickets/{ticketId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
